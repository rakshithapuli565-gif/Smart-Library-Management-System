import React, { useState, useEffect, useMemo, useCallback } from 'react';
import { 
  BookOpen, 
  LayoutDashboard, 
  PlusCircle, 
  BookUp2, 
  BookDown, 
  LogOut, 
  Search, 
  Trash2, 
  Edit, 
  CheckCircle2, 
  AlertCircle, 
  UserCheck, 
  Calendar, 
  DollarSign, 
  Shield, 
  User, 
  Check, 
  Clock,
  Layers,
  ArrowRight,
  Wifi,
  WifiOff,
  UserPlus,
  LogIn
} from 'lucide-react';

// API BASE URL
const API_BASE_URL = 'http://localhost:5000/api';

// Configurable Fine per Day ($1.50 per overdue day)
const FINE_PER_DAY = 1.50;

export default function App() {
  // Current user state
  const [currentUser, setCurrentUser] = useState(() => {
    const saved = localStorage.getItem('library_user');
    return saved ? JSON.parse(saved) : null;
  });

  // Navigation: 'login' | 'dashboard' | 'books' | 'add-book' | 'issue-book' | 'return-book'
  const [activeTab, setActiveTab] = useState('dashboard');

  // Server Online / Offline Status
  const [isServerOnline, setIsServerOnline] = useState(false);
  const [checkingServer, setCheckingServer] = useState(true);

  // Auth Mode: 'login' or 'signup'
  const [authMode, setAuthMode] = useState('login');
  const [authName, setAuthName] = useState('');
  const [authEmail, setAuthEmail] = useState('admin@library.com');
  const [authPassword, setAuthPassword] = useState('admin123');
  const [authRole, setAuthRole] = useState('student');
  const [authError, setAuthError] = useState('');

  // Core Data States
  const [books, setBooks] = useState([]);
  const [issues, setIssues] = useState([]);
  const [usersList, setUsersList] = useState([]);
  const [loading, setLoading] = useState(false);
  const [notification, setNotification] = useState(null);

  // Book Form State (Add / Edit)
  const [editingBookId, setEditingBookId] = useState(null);
  const [bookForm, setBookForm] = useState({
    title: '',
    author: '',
    category: 'Computer Science',
    quantity: 5
  });

  // Issue Form State
  const [issueForm, setIssueForm] = useState({
    user_id: '',
    book_id: '',
    due_days: 14
  });

  // Search & Filter State
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedCategory, setSelectedCategory] = useState('All');

  // Show auto-dismissing notifications
  const showToast = (message, type = 'success') => {
    setNotification({ message, type });
    setTimeout(() => setNotification(null), 4000);
  };

  // Helper for API fetch
  const apiCall = async (endpoint, options = {}) => {
    try {
      const res = await fetch(`${API_BASE_URL}${endpoint}`, {
        headers: { 'Content-Type': 'application/json' },
        ...options
      });
      if (!res.ok) {
        const errorData = await res.json().catch(() => ({}));
        throw new Error(errorData.error || `Error ${res.status}: ${res.statusText}`);
      }
      return await res.json();
    } catch (err) {
      throw err;
    }
  };

  // Check Server Health (Online / Offline status)
  const checkServerStatus = useCallback(async () => {
    try {
      const res = await fetch(`${API_BASE_URL}/health`, { method: 'GET' });
      if (res.ok) {
        setIsServerOnline(true);
      } else {
        setIsServerOnline(false);
      }
    } catch (err) {
      setIsServerOnline(false);
    } finally {
      setCheckingServer(false);
    }
  }, []);

  // Poll server status every 5 seconds
  useEffect(() => {
    checkServerStatus();
    const interval = setInterval(checkServerStatus, 5000);
    return () => clearInterval(interval);
  }, [checkServerStatus]);

  // Initial Data Fetch
  const fetchData = async () => {
    if (!currentUser) return;
    setLoading(true);
    try {
      // 1. Fetch books
      const booksData = await apiCall('/books');
      setBooks(booksData);

      // 2. Fetch issues (Admin gets all, Student gets personal)
      const issuesUrl = currentUser.role === 'admin' 
        ? '/issues' 
        : `/issues/user/${currentUser.id}`;
      const issuesData = await apiCall(issuesUrl);
      setIssues(issuesData);

      // 3. Fetch users for admin dropdown
      if (currentUser.role === 'admin') {
        const usersData = await apiCall('/users');
        setUsersList(usersData);
      }
      setIsServerOnline(true);
    } catch (err) {
      // Standalone preview fallback if backend isn't connected yet
      if (books.length === 0) {
        setBooks([
          { id: 1, title: 'Clean Code: A Handbook of Agile Software', author: 'Robert C. Martin', category: 'Software Engineering', quantity: 5, available: 3 },
          { id: 2, title: 'Design Patterns: Elements of Reusable Object-Oriented Software', author: 'Erich Gamma et al.', category: 'Software Engineering', quantity: 3, available: 1 },
          { id: 3, title: 'Introduction to Algorithms (CLRS)', author: 'Thomas H. Cormen', category: 'Computer Science', quantity: 4, available: 4 },
          { id: 4, title: 'Artificial Intelligence: A Modern Approach', author: 'Stuart Russell', category: 'Artificial Intelligence', quantity: 2, available: 0 },
          { id: 5, database_id: 5, title: 'Database System Concepts', author: 'Abraham Silberschatz', category: 'Database Systems', quantity: 6, available: 5 }
        ]);
        setIssues([
          { 
            id: 1, 
            user_id: 2, 
            user_name: 'John Doe', 
            book_id: 1, 
            book_title: 'Clean Code', 
            issue_date: '2026-08-01', 
            due_date: '2026-08-15', 
            return_date: null, 
            fine: 22.50, 
            status: 'issued' 
          }
        ]);
        setUsersList([
          { id: 1, name: 'System Admin', email: 'admin@library.com', role: 'admin' },
          { id: 2, name: 'John Doe', email: 'student@library.com', role: 'student' }
        ]);
      }
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (currentUser) {
      localStorage.setItem('library_user', JSON.stringify(currentUser));
      fetchData();
    } else {
      localStorage.removeItem('library_user');
      setActiveTab('login');
    }
  }, [currentUser]);

  // Handle Login & Signup
  const handleAuth = async (e) => {
    e.preventDefault();
    setAuthError('');

    try {
      if (authMode === 'login') {
        // --- LOGIN ---
        const data = await apiCall('/auth/login', {
          method: 'POST',
          body: JSON.stringify({ email: authEmail, password: authPassword })
        });
        setCurrentUser(data.user);
        setActiveTab('dashboard');
        showToast(`Welcome back, ${data.user.name}!`);
      } else {
        // --- SIGNUP ---
        if (!authName.trim()) {
          setAuthError('Please enter your full name');
          return;
        }
        const data = await apiCall('/auth/signup', {
          method: 'POST',
          body: JSON.stringify({ 
            name: authName, 
            email: authEmail, 
            password: authPassword, 
            role: authRole 
          })
        });
        setCurrentUser(data.user);
        setActiveTab('dashboard');
        showToast('Account created successfully!');
      }
    } catch (err) {
      // Fallback for offline testing
      if (authMode === 'login') {
        if (authEmail === 'admin@library.com' && authPassword === 'admin123') {
          setCurrentUser({ id: 1, name: 'System Admin', email: 'admin@library.com', role: 'admin' });
          setActiveTab('dashboard');
          showToast('Logged in as Admin (Local State)');
        } else if (authEmail === 'student@library.com' && authPassword === 'student123') {
          setCurrentUser({ id: 2, name: 'John Doe', email: 'student@library.com', role: 'student' });
          setActiveTab('dashboard');
          showToast('Logged in as Student (Local State)');
        } else {
          setAuthError(err.message || 'Invalid email or password.');
        }
      } else {
        const newUser = { id: Date.now(), name: authName, email: authEmail, role: authRole };
        setCurrentUser(newUser);
        setActiveTab('dashboard');
        showToast('Signed up (Local State)');
      }
    }
  };

  const handleLogout = () => {
    setCurrentUser(null);
    setActiveTab('login');
    showToast('Logged out successfully', 'info');
  };

  // Add / Edit Book
  const handleSaveBook = async (e) => {
    e.preventDefault();
    if (!bookForm.title || !bookForm.author || bookForm.quantity < 1) {
      showToast('Please fill all fields accurately', 'error');
      return;
    }

    try {
      if (editingBookId) {
        await apiCall(`/books/${editingBookId}`, {
          method: 'PUT',
          body: JSON.stringify(bookForm)
        });
        showToast('Book updated in MySQL database');
      } else {
        await apiCall('/books', {
          method: 'POST',
          body: JSON.stringify(bookForm)
        });
        showToast('New book added to library inventory');
      }
      await fetchData();
      setBookForm({ title: '', author: '', category: 'Computer Science', quantity: 5 });
      setEditingBookId(null);
      setActiveTab('books');
    } catch (err) {
      if (editingBookId) {
        setBooks(prev => prev.map(b => b.id === editingBookId ? { ...b, ...bookForm } : b));
      } else {
        setBooks(prev => [{ id: Date.now(), ...bookForm, available: bookForm.quantity }, ...prev]);
      }
      setBookForm({ title: '', author: '', category: 'Computer Science', quantity: 5 });
      setEditingBookId(null);
      setActiveTab('books');
      showToast('Book saved');
    }
  };

  const handleDeleteBook = async (id) => {
    if (!window.confirm('Are you sure you want to delete this book?')) return;
    try {
      await apiCall(`/books/${id}`, { method: 'DELETE' });
      showToast('Book deleted from database');
      await fetchData();
    } catch (err) {
      setBooks(prev => prev.filter(b => b.id !== id));
      showToast('Book removed');
    }
  };

  const startEditBook = (book) => {
    setEditingBookId(book.id);
    setBookForm({
      title: book.title,
      author: book.author,
      category: book.category,
      quantity: book.quantity
    });
    setActiveTab('add-book');
  };

  // Issue Book Logic
  const handleIssueBook = async (e) => {
    e.preventDefault();
    const targetUserId = currentUser.role === 'admin' ? issueForm.user_id : currentUser.id;
    const targetBookId = issueForm.book_id;

    if (!targetUserId || !targetBookId) {
      showToast('Please select both user and book', 'error');
      return;
    }

    const selectedBook = books.find(b => b.id === parseInt(targetBookId));
    if (!selectedBook || selectedBook.available < 1) {
      showToast('Book is currently out of stock', 'error');
      return;
    }

    const issueDate = new Date().toISOString().split('T')[0];
    const dueDateObj = new Date();
    dueDateObj.setDate(dueDateObj.getDate() + parseInt(issueForm.due_days || 14));
    const dueDate = dueDateObj.toISOString().split('T')[0];

    try {
      await apiCall('/issues', {
        method: 'POST',
        body: JSON.stringify({
          user_id: targetUserId,
          book_id: targetBookId,
          issue_date: issueDate,
          due_date: dueDate
        })
      });
      showToast(`Book issued! Due date is ${dueDate}`);
      await fetchData();
      setIssueForm({ user_id: '', book_id: '', due_days: 14 });
      setActiveTab('dashboard');
    } catch (err) {
      const newIssue = {
        id: Date.now(),
        user_id: parseInt(targetUserId),
        user_name: usersList.find(u => u.id === parseInt(targetUserId))?.name || currentUser.name,
        book_id: parseInt(targetBookId),
        book_title: selectedBook.title,
        issue_date: issueDate,
        due_date: dueDate,
        return_date: null,
        fine: 0,
        status: 'issued'
      };
      setIssues(prev => [newIssue, ...prev]);
      setBooks(prev => prev.map(b => b.id === parseInt(targetBookId) ? { ...b, available: b.available - 1 } : b));
      showToast(`Book issued! Due: ${dueDate}`);
      setIssueForm({ user_id: '', book_id: '', due_days: 14 });
      setActiveTab('dashboard');
    }
  };

  // Fine Calculation ($1.50 per day after due date)
  const calculateFine = (dueDateStr) => {
    const today = new Date();
    const dueDate = new Date(dueDateStr);
    const diffTime = today - dueDate;
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    if (diffDays > 0) {
      return parseFloat((diffDays * FINE_PER_DAY).toFixed(2));
    }
    return 0.00;
  };

  // Return Book
  const handleReturnBook = async (issueItem) => {
    const returnDate = new Date().toISOString().split('T')[0];
    const fineAmount = calculateFine(issueItem.due_date);

    try {
      await apiCall(`/issues/return/${issueItem.id}`, {
        method: 'PUT',
        body: JSON.stringify({
          return_date: returnDate,
          fine: fineAmount
        })
      });
      showToast(fineAmount > 0 ? `Book returned. Late fine: $${fineAmount.toFixed(2)}` : 'Book returned with $0 fine!');
      await fetchData();
    } catch (err) {
      setIssues(prev => prev.map(item => {
        if (item.id === issueItem.id) {
          return { ...item, return_date: returnDate, fine: fineAmount, status: 'returned' };
        }
        return item;
      }));
      setBooks(prev => prev.map(b => b.id === issueItem.book_id ? { ...b, available: b.available + 1 } : b));
      showToast(fineAmount > 0 ? `Book returned. Late fine: $${fineAmount.toFixed(2)}` : 'Book returned with $0 fine!');
    }
  };

  // Filtered Books List
  const filteredBooks = useMemo(() => {
    return books.filter(book => {
      const matchesSearch = book.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
                            book.author.toLowerCase().includes(searchQuery.toLowerCase()) ||
                            book.category.toLowerCase().includes(searchQuery.toLowerCase());
      const matchesCategory = selectedCategory === 'All' || book.category === selectedCategory;
      return matchesSearch && matchesCategory;
    });
  }, [books, searchQuery, selectedCategory]);

  const categories = useMemo(() => {
    const cats = new Set(books.map(b => b.category));
    return ['All', ...Array.from(cats)];
  }, [books]);

  // Dashboard Metrics
  const stats = useMemo(() => {
    const totalBooks = books.reduce((acc, b) => acc + Number(b.quantity || 0), 0);
    const totalAvailable = books.reduce((acc, b) => acc + Number(b.available || 0), 0);
    const totalIssued = totalBooks - totalAvailable;
    const activeIssues = issues.filter(i => i.status === 'issued');
    const totalFines = issues.reduce((acc, i) => acc + Number(i.fine || 0), 0);
    const overdueCount = issues.filter(i => i.status === 'issued' && calculateFine(i.due_date) > 0).length;

    return {
      totalTitles: books.length,
      totalBooks,
      totalAvailable,
      totalIssued: activeIssues.length,
      totalFines,
      overdueCount
    };
  }, [books, issues]);

  // =========================================================================
  // VIEW: LOGIN & SIGNUP
  // =========================================================================
  if (!currentUser) {
    return (
      <div className="min-h-screen bg-slate-950 flex flex-col items-center justify-center p-4 font-sans text-slate-100 relative overflow-hidden">
        {/* Top Server Status Badge */}
        <div className="absolute top-4 right-4 flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900 border border-slate-800 text-xs shadow-lg">
          <span className="text-slate-400 font-medium">Backend:</span>
          {isServerOnline ? (
            <span className="flex items-center gap-1.5 text-emerald-400 font-semibold">
              <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Online (MySQL Connected)
            </span>
          ) : (
            <span className="flex items-center gap-1.5 text-red-400 font-semibold">
              <span className="w-2 h-2 rounded-full bg-red-400"></span>
              Offline (Port 5000)
            </span>
          )}
        </div>

        <div className="max-w-md w-full bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl p-8 backdrop-blur-xl">
          <div className="text-center mb-6">
            <div className="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-indigo-600/20 text-indigo-400 border border-indigo-500/30 mb-3 shadow-inner">
              <BookOpen className="w-7 h-7" />
            </div>
            <h1 className="text-2xl font-bold tracking-tight text-white">Smart Library Portal</h1>
            <p className="text-xs text-slate-400 mt-1">
              {authMode === 'login' ? 'Sign in to access your library account' : 'Create a new account to borrow books'}
            </p>
          </div>

          {/* Auth Mode Toggle Tabs */}
          <div className="flex bg-slate-800/80 p-1 rounded-xl mb-6 border border-slate-700/60">
            <button
              type="button"
              onClick={() => { setAuthMode('login'); setAuthError(''); }}
              className={`flex-1 py-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition ${
                authMode === 'login' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-400 hover:text-white'
              }`}
            >
              <LogIn className="w-3.5 h-3.5" />
              <span>Login</span>
            </button>
            <button
              type="button"
              onClick={() => { setAuthMode('signup'); setAuthError(''); }}
              className={`flex-1 py-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition ${
                authMode === 'signup' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-400 hover:text-white'
              }`}
            >
              <UserPlus className="w-3.5 h-3.5" />
              <span>Sign Up</span>
            </button>
          </div>

          {authError && (
            <div className="mb-5 p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs flex items-center gap-2">
              <AlertCircle className="w-4 h-4 shrink-0" />
              <span>{authError}</span>
            </div>
          )}

          <form onSubmit={handleAuth} className="space-y-3.5">
            {authMode === 'signup' && (
              <div>
                <label className="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Full Name</label>
                <input
                  type="text"
                  required
                  value={authName}
                  onChange={(e) => setAuthName(e.target.value)}
                  className="w-full px-4 py-2.5 bg-slate-800/80 border border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-white placeholder-slate-500 text-sm"
                  placeholder="e.g. Jane Smith"
                />
              </div>
            )}

            <div>
              <label className="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Email Address</label>
              <input
                type="email"
                required
                value={authEmail}
                onChange={(e) => setAuthEmail(e.target.value)}
                className="w-full px-4 py-2.5 bg-slate-800/80 border border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-white placeholder-slate-500 text-sm"
                placeholder="you@domain.com"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Password</label>
              <input
                type="password"
                required
                value={authPassword}
                onChange={(e) => setAuthPassword(e.target.value)}
                className="w-full px-4 py-2.5 bg-slate-800/80 border border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-white placeholder-slate-500 text-sm"
                placeholder="••••••••"
              />
            </div>

            {authMode === 'signup' && (
              <div>
                <label className="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1">Account Role</label>
                <select
                  value={authRole}
                  onChange={(e) => setAuthRole(e.target.value)}
                  className="w-full px-4 py-2.5 bg-slate-800/80 border border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-white text-sm"
                >
                  <option value="student">Student / Borrower</option>
                  <option value="admin">Library Admin</option>
                </select>
              </div>
            )}

            <button
              type="submit"
              className="w-full mt-2 py-3 px-4 bg-indigo-600 hover:bg-indigo-500 active:scale-[0.99] transition text-white font-medium rounded-xl shadow-lg shadow-indigo-600/30 flex items-center justify-center gap-2 text-sm"
            >
              <span>{authMode === 'login' ? 'Sign In to Portal' : 'Complete Registration'}</span>
              <ArrowRight className="w-4 h-4" />
            </button>
          </form>

          {/* Quick Demo Fill Buttons */}
          <div className="mt-6 pt-5 border-t border-slate-800">
            <p className="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2">One-Click Demo Credentials:</p>
            <div className="grid grid-cols-2 gap-2 text-xs">
              <button 
                type="button"
                onClick={() => { setAuthMode('login'); setAuthEmail('admin@library.com'); setAuthPassword('admin123'); }}
                className="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700/80 text-left border border-slate-700/80 transition"
              >
                <div className="font-semibold text-indigo-300 flex items-center gap-1">
                  <Shield className="w-3.5 h-3.5" /> Admin
                </div>
                <div className="text-slate-400 text-[11px] truncate">admin@library.com</div>
              </button>

              <button 
                type="button"
                onClick={() => { setAuthMode('login'); setAuthEmail('student@library.com'); setAuthPassword('student123'); }}
                className="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700/80 text-left border border-slate-700/80 transition"
              >
                <div className="font-semibold text-emerald-300 flex items-center gap-1">
                  <User className="w-3.5 h-3.5" /> Student
                </div>
                <div className="text-slate-400 text-[11px] truncate">student@library.com</div>
              </button>
            </div>
          </div>
        </div>
      </div>
    );
  }

  // =========================================================================
  // MAIN APPLICATION INTERFACE
  // =========================================================================
  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col md:flex-row font-sans">
      {/* Toast Notification */}
      {notification && (
        <div className={`fixed top-4 right-4 z-50 px-4 py-3 rounded-xl shadow-2xl border flex items-center gap-2.5 backdrop-blur-md transition-all ${
          notification.type === 'error' 
            ? 'bg-red-950/90 border-red-500 text-red-200' 
            : notification.type === 'info'
            ? 'bg-blue-950/90 border-blue-500 text-blue-200'
            : 'bg-emerald-950/90 border-emerald-500 text-emerald-200'
        }`}>
          {notification.type === 'error' ? <AlertCircle className="w-5 h-5 text-red-400" /> : <CheckCircle2 className="w-5 h-5 text-emerald-400" />}
          <span className="text-sm font-medium">{notification.message}</span>
        </div>
      )}

      {/* Sidebar Navigation */}
      <aside className="w-full md:w-64 bg-slate-900 border-r border-slate-800 flex flex-col shrink-0">
        {/* Logo Branding */}
        <div className="p-5 border-b border-slate-800 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-600/30">
              <BookOpen className="w-5 h-5 text-white" />
            </div>
            <div>
              <h2 className="font-bold text-white text-base tracking-tight leading-tight">Smart Library</h2>
              <span className="text-[11px] text-slate-400 font-mono">MySQL Engine</span>
            </div>
          </div>
        </div>

        {/* Server Status Live Pill in Sidebar */}
        <div className="mx-4 mt-3 px-3 py-2 bg-slate-800/40 rounded-xl border border-slate-800 flex items-center justify-between">
          <div className="flex items-center gap-2">
            {isServerOnline ? (
              <Wifi className="w-3.5 h-3.5 text-emerald-400" />
            ) : (
              <WifiOff className="w-3.5 h-3.5 text-red-400" />
            )}
            <span className="text-xs font-medium text-slate-300">Backend Server</span>
          </div>
          <span className={`text-[10px] font-bold uppercase px-2 py-0.5 rounded-full ${
            isServerOnline 
              ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' 
              : 'bg-red-500/20 text-red-400 border border-red-500/30'
          }`}>
