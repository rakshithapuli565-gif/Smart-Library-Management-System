                  {books.map((b) => (
                    <option key={b.id} value={b.id} disabled={b.available <= 0}>
                      {b.title} by {b.author} ({b.available > 0 ? `${b.available} copies available` : 'Out of stock'})
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">Loan Duration (Days)</label>
                <select
                  value={issueForm.due_days}
                  onChange={(e) => setIssueForm({ ...issueForm, due_days: e.target.value })}
                  className="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
                >
                  <option value="7">7 Days (1 Week)</option>
                  <option value="14">14 Days (2 Weeks - Standard)</option>
                  <option value="30">30 Days (1 Month)</option>
                </select>
              </div>

              <div className="p-3.5 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-xs text-indigo-300 flex items-center gap-2">
                <Clock className="w-4 h-4 shrink-0" />
                <span>Note: A late fee of ${FINE_PER_DAY.toFixed(2)} per day applies automatically if returned past due date.</span>
              </div>

              <div className="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
                <button
                  type="submit"
                  className="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-sm font-semibold shadow-lg shadow-indigo-600/30 transition flex items-center gap-2"
                >
                  <BookUp2 className="w-4 h-4" />
                  <span>Confirm Book Issue</span>
                </button>
              </div>
            </form>
          </div>
        )}

        {/* TAB 5: RETURN BOOK */}
        {activeTab === 'return-book' && (
          <div className="space-y-6">
            <div className="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
              <div className="p-5 border-b border-slate-800">
                <h2 className="text-lg font-bold text-white">Return Borrowed Books</h2>
                <p className="text-xs text-slate-400 mt-1">Select an active issue to process return, update inventory & compute late fees</p>
              </div>

              {issues.filter(i => i.status === 'issued').length === 0 ? (
                <div className="p-12 text-center text-slate-500 text-sm">
                  No active loans requiring return at this moment.
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full text-left text-sm text-slate-300">
                    <thead className="bg-slate-800/70 text-[11px] uppercase tracking-wider text-slate-400 font-semibold">
                      <tr>
                        <th className="px-5 py-3">Book Title</th>
                        {currentUser.role === 'admin' && <th className="px-5 py-3">Borrower</th>}
                        <th className="px-5 py-3">Issued On</th>
                        <th className="px-5 py-3">Due Date</th>
                        <th className="px-5 py-3">Current Fine</th>
                        <th className="px-5 py-3 text-right">Action</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-800">
                      {issues.filter(i => i.status === 'issued').map((issue) => {
                        const calculatedLateFee = calculateFine(issue.due_date);
                        return (
                          <tr key={issue.id} className="hover:bg-slate-800/40 transition">
                            <td className="px-5 py-3.5 font-medium text-white">{issue.book_title || `Book #${issue.book_id}`}</td>
                            {currentUser.role === 'admin' && (
                              <td className="px-5 py-3.5 text-slate-400 text-xs">{issue.user_name || `User #${issue.user_id}`}</td>
                            )}
                            <td className="px-5 py-3.5 text-xs text-slate-400">{issue.issue_date}</td>
                            <td className="px-5 py-3.5 text-xs text-slate-400">{issue.due_date}</td>
                            <td className="px-5 py-3.5 text-xs">
                              {calculatedLateFee > 0 ? (
                                <span className="font-bold text-red-400">${calculatedLateFee.toFixed(2)} (Overdue)</span>
                              ) : (
                                <span className="text-emerald-400 font-medium">$0.00 (On Time)</span>
                              )}
                            </td>
                            <td className="px-5 py-3.5 text-right">
                              <button
                                onClick={() => handleReturnBook(issue)}
                                className="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-semibold shadow-md shadow-emerald-600/20 transition flex items-center gap-1.5 ml-auto"
                              >
                                <BookDown className="w-3.5 h-3.5" />
                                <span>Process Return</span>
                              </button>
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        )}
      </main>
    </div>
  );
}
