const express = require('express');
require('dotenv').config();
const mongoose = require('mongoose');
const cors = require('cors');
const bcrypt = require('bcryptjs');

const app = express();
const PORT = process.env.PORT || 5000;

// =============================================================
// MongoDB Atlas Connection
// =============================================================

const MONGO_URI = process.env.MONGO_URI;

if (!MONGO_URI) {
  console.error('❌ MONGO_URI is not defined in .env');
  process.exit(1);
}

mongoose.connect(MONGO_URI)
  .then(() => {
    console.log('====================================================');
    console.log(' MongoDB Connected Successfully to ResumeAI Pro!');
    console.log('====================================================');
  })
  .catch((err) => {
    console.error('❌ MongoDB Connection Error:', err.message);
  });

// =============================================================
// Middleware
// =============================================================

app.use(cors({
  origin: '*',
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS'],
  allowedHeaders: ['Content-Type', 'x-user-id']
}));

app.use(express.json({ limit: '10mb' }));
app.use(express.urlencoded({ extended: true, limit: '10mb' }));

// =============================================================
// 1. User Account Schema
// =============================================================

const userSchema = new mongoose.Schema({
  name: {
    type: String,
    required: true,
    trim: true
  },

  email: {
    type: String,
    required: true,
    unique: true,
    lowercase: true,
    trim: true
  },

  password: {
    type: String,
    required: true
  },

  createdAt: {
    type: Date,
    default: Date.now
  }
});

const User = mongoose.model('User', userSchema);

// =============================================================
// 2. Resume Data Schema
// =============================================================

const resumeSchema = new mongoose.Schema({

  userId: {
    type: String,
    required: true,
    unique: true
  },

  personalInfo: {
    fullName: { type: String, default: '' },
    jobTitle: { type: String, default: '' },
    email: { type: String, default: '' },
    phone: { type: String, default: '' },
    location: { type: String, default: '' },
    linkedin: { type: String, default: '' },
    github: { type: String, default: '' },
    portfolio: { type: String, default: '' },
    avatar: { type: String, default: '' },
    summary: { type: String, default: '' }
  },

  education: [
    {
      id: String,
      institution: String,
      degree: String,
      field: String,
      startYear: String,
      endYear: String,
      grade: String
    }
  ],

  experience: [
    {
      id: String,
      company: String,
      jobTitle: String,
      location: String,
      startDate: String,
      endDate: String,
      description: String
    }
  ],

  skills: [
    {
      id: String,
      name: String,
      level: {
        type: String,
        default: 'Strong'
      }
    }
  ],

  projects: [
    {
      id: String,
      name: String,
      description: String,
      technologies: String,
      projectUrl: String,
      githubUrl: String
    }
  ],

  certifications: [
    {
      id: String,
      name: String,
      issuer: String,
      date: String,
      url: String
    }
  ],

  achievements: [
    {
      id: String,
      title: String,
      description: String
    }
  ],

  languages: [
    {
      id: String,
      name: String,
      proficiency: String
    }
  ],

  updatedAt: {
    type: Date,
    default: Date.now
  }

});

const Resume = mongoose.model('Resume', resumeSchema);

// =============================================================
// Health Check
// =============================================================

app.get('/api/health', (req, res) => {

  const isDbConnected = mongoose.connection.readyState === 1;

  res.status(200).json({

    status: 'Online',

    serverRunning: true,

    message: isDbConnected
      ? 'Express server is running and MongoDB is connected!'
      : 'Express server is running, but MongoDB is connecting/disconnected.',

    database: isDbConnected
      ? 'Connected (MongoDB)'
      : 'Connecting / Disconnected',

    serverTime: new Date().toISOString()

  });

});

// =============================================================
// POST /api/auth/signup
// =============================================================

app.post('/api/auth/signup', async (req, res) => {

  try {

    const { name, email, password } = req.body;

    if (!name || !email || !password) {

      return res.status(400).json({
        success: false,
        serverRunning: true,
        error: 'Name, email, and password are required.'
      });

    }

    const existingUser = await User.findOne({
      email: email.toLowerCase()
    });

    if (existingUser) {

      return res.status(400).json({
        success: false,
        serverRunning: true,
        error: 'An account with this email already exists.'
      });

    }

    const salt = await bcrypt.genSalt(10);

    const hashedPassword = await bcrypt.hash(
      password,
      salt
    );

    const newUser = await User.create({
      name,
      email: email.toLowerCase(),
      password: hashedPassword
    });

    res.status(201).json({

      success: true,

      serverRunning: true,

      message: 'Server is running! Account created successfully in MongoDB.',

      user: {
        id: newUser._id.toString(),
        name: newUser.name,
        email: newUser.email
      }

    });

  } catch (error) {

    console.error('Signup Error:', error);

    res.status(500).json({

      success: false,

      serverRunning: true,

      error: error.message || 'Internal Server Error'

    });

  }

});

// =============================================================
// POST /api/auth/login
// =============================================================

app.post('/api/auth/login', async (req, res) => {

  try {

    const { email, password } = req.body;

    if (!email || !password) {

      return res.status(400).json({

        success: false,

        serverRunning: true,

        error: 'Email and password are required.'

      });

    }

    const user = await User.findOne({
      email: email.toLowerCase()
    });

    if (!user) {

      return res.status(401).json({

        success: false,

        serverRunning: true,

        error: 'Invalid email or password.'

      });

    }

    const isMatch = await bcrypt.compare(
      password,
      user.password
    );

    if (!isMatch) {

      return res.status(401).json({

        success: false,

        serverRunning: true,

        error: 'Invalid email or password.'

      });

    }

    res.status(200).json({

      success: true,

      serverRunning: true,

      message: 'Server is running! Logged in successfully.',

      user: {
        id: user._id.toString(),
        name: user.name,
        email: user.email
      }

    });

  } catch (error) {

    console.error('Login Error:', error);

    res.status(500).json({

      success: false,

      serverRunning: true,

      error: error.message || 'Internal Server Error'

    });

  }

});

// =============================================================
// GET /api/resume/:userId
// =============================================================

app.get('/api/resume/:userId', async (req, res) => {

  try {

    const { userId } = req.params;

    const resume = await Resume.findOne({
      userId
    });

    if (!resume) {

      return res.status(200).json({

        success: true,

        serverRunning: true,

        data: null,

        message: 'No resume profile saved yet for this account.'

      });

    }

    res.status(200).json({

      success: true,

      serverRunning: true,

      data: resume,

      message: 'Resume loaded successfully from MongoDB.'

    });

  } catch (error) {

    console.error('Fetch Resume Error:', error);

    res.status(500).json({

      success: false,

      serverRunning: true,

      error: error.message

    });

  }

});

// =============================================================
// POST /api/resume/sync
// =============================================================

app.post('/api/resume/sync', async (req, res) => {

  try {

    const {
      userId,
      resumeData
    } = req.body;

    if (!userId || !resumeData) {

      return res.status(400).json({

        success: false,

        serverRunning: true,

        error: 'User ID and resume payload are required.'

      });

    }

    const updatedResume =
      await Resume.findOneAndUpdate(

        { userId },

        {
          ...resumeData,
          userId,
          updatedAt: new Date()
        },

        {
          new: true,
          upsert: true,
          setDefaultsOnInsert: true
        }

      );

    res.status(200).json({

      success: true,

      serverRunning: true,

      message: 'Server is running! Resume synchronized and saved to MongoDB.',

      data: updatedResume

    });

  } catch (error) {

    console.error('Sync Resume Error:', error);

    res.status(500).json({

      success: false,

      serverRunning: true,

      error: error.message

    });

  }

});

// =============================================================
// DELETE /api/resume/:userId
// =============================================================

app.delete('/api/resume/:userId', async (req, res) => {

  try {

    const { userId } = req.params;

    await Resume.findOneAndDelete({
      userId
    });

    res.status(200).json({

      success: true,

      serverRunning: true,

      message: 'Resume deleted from database.'

    });

  } catch (error) {

    console.error('Delete Resume Error:', error);

    res.status(500).json({

      success: false,

      serverRunning: true,

      error: error.message

    });

  }

});

// =============================================================
// Start Server
// =============================================================

app.listen(PORT, () => {

  console.log(
    `🚀 ResumeAI Pro Express Server listening on port ${PORT}`
  );

  console.log(
    `👉 Health check: http://localhost:${PORT}/api/health`
  );

});
